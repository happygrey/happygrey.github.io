      "Bash(python3 -c \"import fitz\")",
      "Bash(python3 -c \"import PyPDF2\")",
      "Bash(python3 -c \"import pypdf\")",
      "Bash(mdls -name kMDItemNumberOfPages -name kMDItemTextContent /tmp/tectonic-install/resume.pdf)",
