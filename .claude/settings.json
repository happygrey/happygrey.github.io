      "Bash(curl -sL --max-time 60 -o /tmp/tectonic-install/tectonic.tar.gz \"https://github.com/tectonic-typesetting/tectonic/releases/download/tectonic%400.17.0/tectonic-0.17.0-aarch64-apple-darwin.tar.gz\")",
      "Bash(tar -xzf /tmp/tectonic-install/tectonic.tar.gz -C /tmp/tectonic-install)",
